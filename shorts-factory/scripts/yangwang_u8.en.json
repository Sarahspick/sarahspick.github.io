  "sentences": [
    {
      "lines": [
        "It's the *Yangwang U8*,",
        "a $150,000 SUV from BYD."
      ],
      "clip": "y_ramp"
    },
    {
      "lines": [
        "When the water gets too deep,",
        "it flips into *emergency floating mode*."
      ],
      "clip": "y_dash",
      "sfx": [
        {
          "id": "confirm",
          "at": "line2"
        }
      ]
    },
    {
      "lines": [
        "The engine shuts off,",
        "the windows seal shut,"
      ],
      "clip": "y_cabin"
    },
    {
      "lines": [
        "and the suspension lifts",
        "all the way up."
      ],
      "clip": "y_side"
    },
    {
      "lines": [
        "The sunroof even opens",
        "as an *escape hatch*."
      ],
      "clip": "y_roof"
    },
    {
      "lines": [
        "It can stay afloat",
        "for about *30 minutes*…"
      ],
      "clip": "y_aerial",
      "sfx": [
        {
          "id": "wow",
          "at": "end",
          "gain": -4
        }
      ]
    },
    {
      "lines": [
        "…and paddle forward at *3 km/h*",
        "just by spinning its wheels."
      ],
      "clips": [
        "y_speed",
        "y_boat"
      ]
    },
    {
      "lines": [
        "The secret?",
        "*Four* motors, one for each wheel."
      ],
      "clip": "y_wheel",
      "punch": true
    },
    {
      "lines": [
        "That's also how it spins",
        "in place like a *tank*."
      ],
      "clip": "y_tank"
    },
    {
      "lines": [
        "But here's the crazy part…"
      ],
      "clip": "y_exit",
      "pause_after": 0.25,
      "sfx": [
        {
          "id": "dun_dun",
          "at": "start",
          "gain": -5,
          "dur": 2.0
        }
      ]
    },
    {
      "lines": [
        "this thing weighs almost *3.5 tons*."
      ],
      "clip": "y_exit2",
      "punch": true,
      "sfx": [
        {
          "id": "boom",
          "at": "word:tons"
        }
      ]
    },
    {
      "lines": [
        "Would *you* drive it into a lake?"
      ],
      "clip": "y_shore"
    }
  ],
