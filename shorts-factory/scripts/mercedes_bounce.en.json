        "at": "word:bounce"
      }
    ]
  },
  "sentences": [
    {
      "lines": [
        "It's stuck in a dune.",
        "Wheels spinning."
      ],
      "clips": [
        "c_stuck_side",
        "c_stuck_front"
      ]
    },
    {
      "lines": [
        "Going *nowhere*."
      ],
      "clip": "c_stuck_front"
    },
    {
      "lines": [
        "So the driver taps one button…"
      ],
      "clip": "c_screen",
      "sfx": [
        {
          "id": "mouse_click",
          "at": "word:button"
        }
      ]
    },
    {
      "lines": [
        "…and the whole car starts *rocking*."
      ],
      "clip": "c_rock1",
      "punch": true,
      "pause_after": 1.1,
      "sfx": [
        {
          "id": "boom",
          "at": "word:rocking"
        },
        {
          "id": "omg",
          "at": "end+0.05",
          "gain": -3
        }
      ]
    },
    {
      "lines": [
        "It pumps its suspension",
        "up and down, over and over,"
      ],
      "clip": "c_rock2"
    },
    {
      "lines": [
        "changing how hard each tire",
        "presses into the sand…"
      ],
      "clip": "c_rock_side"
    },
    {
      "lines": [
        "…until it finally grips",
        "and rocks itself *free*."
      ],
      "clip": "c_escape",
      "sfx": [
        {
          "id": "ding",
          "at": "word:free"
        }
      ]
    },
    {
      "lines": [
        "The secret?",
        "A *48-volt* active suspension"
      ],
      "clip": "c_display",
      "punch": true
    },
    {
      "lines": [
        "that controls every wheel",
        "*on its own*."
      ],
      "clip": "c_sliders"
    },
    {
      "lines": [
        "It even reads the road",
        "and flattens bumps before you feel them."
      ],
      "clip": "c_compare"
    },
    {
      "lines": [
        "But here's the *twist*…"
      ],
      "clip": "c_dunes",
      "pause_after": 0.3,
      "sfx": [
        {
          "id": "dun_dun",
          "at": "start",
          "gain": -5,
          "dur": 2.2
        }
      ]
    },
    {
      "lines": [
        "Barely anyone *paid* for it."
      ],
      "clip": "c_parked",
      "punch": true,
      "sfx": [
        {
          "id": "boom",
          "at": "word:paid"
        }
      ]
    },
    {
      "lines": [
        "So Mercedes quietly *dropped* it",
        "from the GLE in America."
      ],
      "clip": "card_takerate",
      "annotate": [
        {
          "type": "stamp",
          "at": "word:dropped",
          "text": "DROPPED",
          "x": 0.74,
          "y": 0.15
        }
      ]
    },
    {
      "lines": [
        "Would *you* pay extra for this?"
      ],
      "clip": "c_charge"
    }
