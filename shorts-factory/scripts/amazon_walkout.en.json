        "x": 0.52,
        "y": 0.42,
        "angle": 30
      }
    ],
    "sfx": [
      {
        "id": "boom",
        "at": "word:paying"
      }
    ]
  },
  "sentences": [
    {
      "lines": [
        "Because this is *Amazon Go*."
      ],
      "clip": "c_store"
    },
    {
      "lines": [
        "You scan your phone,",
        "grab what you want…",
        "and just *leave*."
      ],
      "clips": [
        "c_gate",
        "c_grab",
        "c_exit"
      ],
      "sfx": [
        {
          "id": "confirm",
          "at": "word:phone"
        }
      ]
    },
    {
      "lines": [
        "No cashier. No line.",
        "The bill just pops up on your *phone*."
      ],
      "clip": "c_receipt",
      "sfx": [
        {
          "id": "ding",
          "at": "word:phone+0.15"
        }
      ]
    },
    {
      "lines": [
        "So how does it *know*?"
      ],
      "clip": "c_tech",
      "punch": true
    },
    {
      "lines": [
        "*Hundreds* of ceiling cameras",
        "track every shopper,"
      ],
      "clip": "c_ceiling"
    },
    {
      "lines": [
        "and shelf sensors *feel*",
        "every item you lift."
      ],
      "clip": "c_cart"
    },
    {
      "lines": [
        "But in 2024, a report",
        "dropped a *bombshell*."
      ],
      "clip": "c_crowd",
      "pause_after": 0.2,
      "sfx": [
        {
          "id": "dun_dun",
          "at": "line2",
          "gain": -5,
          "dur": 2.2
        }
      ]
    },
    {
      "lines": [
        "About *1,000 workers* in India",
        "were checking the trips."
      ],
      "clip": "card_report",
      "punch": true,
      "sfx": [
        {
          "id": "boom",
          "at": "word:workers"
        }
      ],
      "annotate": [
        {
          "type": "stamp",
          "at": "line2",
          "text": "CLASSIFIED",
          "x": 0.74,
          "y": 0.15
        }
      ]
    },
    {
      "lines": [
        "It said back in 2022,",
        "*7 in 10* sales needed",
        "a human check."
      ],
      "clip": "card_700",
      "pause_after": 0.5,
      "sfx": [
        {
          "id": "gasp",
          "at": "end"
        }
      ]
    },
    {
      "lines": [
        "Amazon denied it —",
        "the team was mostly",
        "*training* the AI."
      ],
      "clip": "card_amazon"
    },
    {
      "lines": [
        "Then in 2026, Amazon",
        "shut down *every* Amazon Go."
      ],
      "clip": "card_closed",
      "punch": true,
      "pause_after": 0.95,
      "sfx": [
        {
          "id": "wait_what",
          "at": "end+0.05"
        }
      ]
    },
    {
      "lines": [
        "But the tech lives on —",
        "it's now in about *360* places,",
        "from stadiums to hospitals."
      ],
      "clip": "c_gates"
    },
    {
      "lines": [
        "Would *you* shop like this?"
      ],
      "clip": "c_hook"
    }
  ],
