 "captions": [
  {
   "t": 0,
   "d": 4.7,
   "text": "This is David Goggins\nat *297 pounds*",
   "style": "memebar"
  },
  {
   "t": 4.7,
   "d": 3.4,
   "text": "*Donuts* and a *milkshake*\nevery night",
   "style": "memebar"
  },
  {
   "t": 8.1,
   "d": 3.05,
   "text": "The Navy SEAL limit\nfor his height: *191 lbs*",
   "style": "memebar"
  },
  {
   "t": 11.15,
   "d": 3.2,
   "text": "He had to lose *106 lbs*\nin *3 months*",
   "style": "memebar"
  },
  {
   "t": 14.35,
   "d": 2.75,
   "text": "...and he *did it* :fire:",
   "style": "memebar"
  },
  {
   "t": 17.1,
   "d": 5.4,
   "text": "The only man in SEAL history\nwith *3 Hell Weeks* in 1 year",
   "style": "memebar"
  },
  {
   "t": 22.5,
   "d": 2.6,
   "text": "Stress fractures.\nNo more *quitting.*",
   "style": "memebar"
  },
  {
   "t": 25.1,
   "d": 1.6,
   "text": "He *duct taped* his legs",
   "style": "memebar"
  },
  {
   "t": 26.7,
   "d": 2.8,
   "text": "Then he went after the\n*pull up world record*",
   "style": "memebar"
  },
  {
   "t": 29.5,
   "d": 2.6,
   "text": "*4,030 pull ups*\nin 17 hours :flexed-biceps:",
   "style": "memebar"
  },
  {
   "t": 32.1,
   "d": 3.4,
   "text": "\"The mind is the most\n*powerful weapon* we have\"",
   "style": "memebar"
  }
 ],
