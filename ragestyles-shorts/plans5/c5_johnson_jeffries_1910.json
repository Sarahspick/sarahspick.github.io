 "captions": [
  {
   "t": 0,
   "d": 28.6,
   "text": "The Fight of the Century\n(1910) :boxing-glove:",
   "style": "title",
   "y": 0.12,
   "anim": "none"
  },
  {
   "t": 0.0,
   "d": 2.8,
   "text": "An undefeated champion\ngoes down :skull:",
   "style": "title",
   "y": 0.77,
   "size": 64
  },
  {
   "t": 2.8,
   "d": 2.4,
   "text": "*20,000* people came\nto Reno, Nevada",
   "style": "title",
   "y": 0.77,
   "size": 64
  },
  {
   "t": 5.2,
   "d": 2.6,
   "text": "Jack Johnson\n*world heavyweight champion*",
   "style": "title",
   "y": 0.77,
   "size": 64
  },
  {
   "t": 7.8,
   "d": 2.6,
   "text": "James Jeffries\n*never lost a fight*",
   "style": "title",
   "y": 0.77,
   "size": 64
  },
  {
   "t": 10.4,
   "d": 2.6,
   "text": "Jeffries came out of retirement\nto take the title back",
   "style": "title",
   "y": 0.77,
   "size": 64
  },
  {
   "t": 13.0,
   "d": 1.2,
   "text": "Round *15*",
   "style": "title",
   "y": 0.77,
   "size": 64
  },
  {
   "t": 14.2,
   "d": 4.2,
   "text": "Jeffries goes down for the\n*first time in his career*",
   "style": "title",
   "y": 0.77,
   "size": 64
  },
  {
   "t": 18.4,
   "d": 3.4,
   "text": "He gets up... and goes down *again*",
   "style": "title",
   "y": 0.77,
   "size": 64
  },
  {
   "t": 21.8,
   "d": 3.6,
   "text": "His corner *stops the fight*",
   "style": "title",
   "y": 0.77,
   "size": 64
  },
  {
   "t": 25.4,
   "d": 3.2,
   "text": "Jack Johnson *keeps his title* :trophy:",
   "style": "title",
   "y": 0.77,
   "size": 64
  }
 ],
