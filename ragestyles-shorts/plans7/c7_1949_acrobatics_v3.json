 "captions": [
  {
   "t": 0,
   "d": 24.0,
   "text": "College acrobatics in 1949\nwas *built different* :skull:",
   "style": "title",
   "anim": "none"
  },
  {
   "t": 0.0,
   "d": 3.2,
   "text": "UP ON HIS\n*SHOULDERS*",
   "style": "big"
  },
  {
   "t": 3.2,
   "d": 3.4,
   "text": "SITTING ON HIS\n~PARTNER'S SHOULDERS~",
   "style": "big"
  },
  {
   "t": 6.6,
   "d": 2.8,
   "text": "NOW HE'S\n*STANDING* ON HIM",
   "style": "big"
  },
  {
   "t": 9.4,
   "d": 2.6,
   "text": "WHILE A TEAMMATE\n~DIVE ROLLS~ PAST",
   "style": "big"
  },
  {
   "t": 12.0,
   "d": 3.0,
   "text": "*COUNTERBALANCE*",
   "style": "big"
  },
  {
   "t": 15.0,
   "d": 4.0,
   "text": "~UPSIDE DOWN~\nON HIS PARTNER",
   "style": "big"
  },
  {
   "t": 19.0,
   "d": 2.0,
   "text": "*BACK WALKOVER*",
   "style": "big"
  },
  {
   "t": 21.0,
   "d": 3.0,
   "text": "NO GYM MACHINES.\n*JUST BODYWEIGHT* :flexed-biceps:",
   "style": "big"
  }
 ],
