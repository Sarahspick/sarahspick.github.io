 "captions": [
  {
   "t": 0,
   "d": 25.0,
   "text": "What astronauts did\nfor fun on the Moon :rocket:",
   "style": "title",
   "y": 0.12,
   "anim": "none"
  },
  {
   "t": 0.0,
   "d": 2.5,
   "text": "\"Give me a salute\"",
   "style": "sub",
   "y": 0.72,
   "size": 68
  },
  {
   "t": 2.5,
   "d": 2.1,
   "text": "\"Big Navy salute\"",
   "style": "sub",
   "y": 0.72,
   "size": 68
  },
  {
   "t": 4.6,
   "d": 4.2,
   "text": "\"Off the ground, *one more*\" :flushed-face:",
   "style": "sub",
   "y": 0.72,
   "size": 68
  },
  {
   "t": 8.8,
   "d": 3.2,
   "text": "\"Man, you are really *bouncing*\"",
   "style": "sub",
   "y": 0.72,
   "size": 68
  },
  {
   "t": 12.0,
   "d": 3.0,
   "text": "\"He's got about *two wheels* on the ground\"",
   "style": "sub",
   "y": 0.72,
   "size": 64
  },
  {
   "t": 15.0,
   "d": 4.2,
   "text": "\"A big *rooster tail* out of all four wheels\"",
   "style": "sub",
   "y": 0.72,
   "size": 64
  },
  {
   "t": 19.2,
   "d": 5.8,
   "text": "\"He skids the back end...\njust like on *snow*\" :skull:",
