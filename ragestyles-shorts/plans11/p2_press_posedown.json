   "y": 0.72,
   "anim": "pop"
  },
  {
   "t": 14.12,
   "d": 0.54,
   "text": "ARE ONE FROM",
   "style": "wordcap",
   "y": 0.72,
   "anim": "pop"
  },
  {
   "t": 14.66,
   "d": 0.78,
   "text": "THE ~BACK~ WHO'S",
   "style": "wordcap",
   "y": 0.72,
   "anim": "pop"
  },
  {
   "t": 15.44,
   "d": 1.04,
   "text": "*WINNING* THIS",
   "style": "wordcap",
   "y": 0.72,
   "anim": "pop"
  },
  {
   "t": 16.48,
   "d": 0.76,
   "text": "DO YOU ALL",
   "style": "wordcap",
   "y": 0.72,
   "anim": "pop"
  },
  {
   "t": 17.24,
   "d": 0.91,
   "text": "~DEREK~ WHO DO YOU",
