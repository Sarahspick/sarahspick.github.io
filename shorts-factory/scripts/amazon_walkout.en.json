  "hook": {
    "lines": [
      "This guy just walked out",
      "without paying…",
      "and nobody stopped him."
    ],
    "clips": [
      "c_hook",
      "c_hook",
      "c_hook2"
    ],
    "annotate": [
      {
        "type": "arrow",
        "at": 0,
