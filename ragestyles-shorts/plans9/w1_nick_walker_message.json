   "y": 0.5,
   "anim": "pop"
  },
  {
   "t": 8.84,
   "d": 0.8,
   "text": "OUT THERE TO TAKE",
   "style": "word",
   "y": 0.5,
   "anim": "pop"
  },
  {
   "t": 9.64,
   "d": 1.38,
   "text": "THIS AND +LEARN+ THIS",
