   "y": 0.86
  },
  {
   "t": 0.0,
   "d": 0.62,
   "text": "*LADIES*",
   "style": "wordcap",
   "y": 0.72,
   "anim": "pop"
  },
  {
   "t": 0.62,
   "d": 0.92,
   "text": "AND ~GENTLEMEN~",
   "style": "wordcap",
   "y": 0.72,
   "anim": "pop"
  },
  {
   "t": 1.54,
   "d": 1.5,
   "text": "IT IS TIME",
   "style": "wordcap",
   "y": 0.72,
   "anim": "pop"
  },
  {
   "t": 3.04,
   "d": 2.91,
   "text": "TO *POSE*",
   "style": "wordcap",
   "y": 0.72,
   "anim": "pop"
  },
  {
   "t": 6.48,
   "d": 2.06,
   "text": "IS ~OFFICIALLY~",
   "style": "wordcap",
   "y": 0.72,
   "anim": "pop"
  },
  {
   "t": 8.54,
   "d": 1.3,
   "text": "JOE *WEEDER'S*",
   "style": "wordcap",
   "y": 0.72,
   "anim": "pop"
  },
  {
   "t": 9.84,
   "d": 1.32,
   "text": "~OLYMPIA~ IS OFF",
   "style": "wordcap",
   "y": 0.72,
   "anim": "pop"
  },
  {
   "t": 11.16,
   "d": 1.7,
   "text": "TO A *RIP-ROARING*",
   "style": "wordcap",
   "y": 0.72,
   "anim": "pop"
  },
  {
   "t": 12.86,
   "d": 0.6,
   "text": "~RIGHT~",
   "style": "wordcap",
   "y": 0.72,
   "anim": "pop"
  },
  {
   "t": 13.46,
   "d": 0.66,
   "text": "THEY SAY *SHOWS*",
